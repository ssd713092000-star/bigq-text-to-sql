# Copy to infra/.env (gitignored) and fill in.  Used by infra/docker-compose.yaml.
# Phases add more keys; each is marked with the phase that first needs it.

# ---------- GCP ----------
GCP_PROJECT=your-gcp-project-id
BQ_LOCATION=asia-south1          # BigQuery dataset + export bucket location
GEMINI_LOCATION=global
CLAUDE_LOCATION=us-east5
RAG_LOCATION=us-central1         # RAG Engine Serverless mode is us-central1 only

# Host gcloud ADC folder, mounted read-only into api + mcp (run `gcloud auth application-default login` first)
#   Windows:       GCLOUD_CONFIG_DIR=C:/Users/<you>/AppData/Roaming/gcloud
#   Linux / macOS: GCLOUD_CONFIG_DIR=/home/<you>/.config/gcloud   (or /Users/<you>/.config/gcloud)
GCLOUD_CONFIG_DIR=

# ---------- Postgres (local container) ----------
DB_NAME=analyst
DB_USER=analyst
DB_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=5432

# ---------- BigQuery limits / exports ----------
BQ_DATASET=nyc_taxi              # phase 1 only; removed when the MCP becomes multi-dataset (phase 3)
BQ_MAX_GB=2
BQ_MAX_ROWS=500
EXPORT_BUCKET=
SIGNER_SERVICE_ACCOUNT=

# ---------- Verified examples (RAG) ----------
EXAMPLES_BUCKET=
# phase 1 only; phase 4 creates corpora per org/user
RAG_CORPUS_NAME=

# ---------- Auth (phase 2) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32
AUTH_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

LOG_LEVEL=INFO
